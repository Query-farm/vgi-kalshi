# name: test/sql/trades_candles.test
# description: trades() and candlesticks(): time windows, paging, row caps
# group: [kalshi]
#
# Runs offline against the fake Kalshi API (test/mock_api/server.py: the
# synthetic DEMOWX fixtures in notebooks/surface_fixtures.json plus one recorded
# KXBTCD market and order book) through ci/run-integration.sh.

require vgi

require-env VGI_KALSHI_WORKER

require-env KALSHI_BASE_URL

statement ok
ATTACH 'kalshi' (TYPE vgi, LOCATION '{VGI_KALSHI_WORKER}');

# Six trades at four per page.
query TTTTTT
SELECT trade_id, created_time, taker_side, yes_price_dollars, no_price_dollars, count_fp FROM kalshi.main.trades('DEMOWX-26NOV15-T20') ORDER BY trade_id;
----
DEMOWX-26NOV15-T20-1	2026-11-14 08:10:00+00	yes	0.4000	0.6000	10.00
DEMOWX-26NOV15-T20-2	2026-11-14 08:50:00+00	no	0.6000	0.4000	30.00
DEMOWX-26NOV15-T20-3	2026-11-14 10:10:00+00	yes	0.5000	0.5000	20.00
DEMOWX-26NOV15-T20-4	2026-11-14 10:50:00+00	no	0.8000	0.2000	40.00
DEMOWX-26NOV15-T20-5	2026-11-14 11:10:00+00	yes	0.7000	0.3000	5.00
DEMOWX-26NOV15-T20-6	2026-11-14 11:50:00+00	no	0.9000	0.1000	15.00

# min_ts/max_ts are epoch seconds: 08:00-10:00 UTC.
query T
SELECT trade_id FROM kalshi.main.trades('DEMOWX-26NOV15-T20', min_ts => 1794643200, max_ts => 1794650400) ORDER BY trade_id;
----
DEMOWX-26NOV15-T20-1
DEMOWX-26NOV15-T20-2

query I
SELECT count(*) FROM kalshi.main.trades('DEMOWX-26NOV15-T20', max_rows => 3);
----
3

query T
SELECT sum(count_fp) FROM kalshi.main.trades('DEMOWX-26NOV15-T20') WHERE taker_side = 'yes';
----
35.00

query I
SELECT count(*) FROM kalshi.main.trades('NO-SUCH-TICKER');
----
0

# Hourly candles, 08:00-12:00 UTC. An hour with no trades has no prices.
query TTTTTT
SELECT end_period_ts, volume_fp, price_open_dollars, price_high_dollars, price_low_dollars, price_close_dollars FROM kalshi.main.candlesticks('DEMOWX', 'DEMOWX-26NOV15-T20', start_ts => 1794643200, end_ts => 1794657600) ORDER BY end_period_ts;
----
2026-11-14 09:00:00+00	40.00	0.4000	0.6000	0.4000	0.6000
2026-11-14 10:00:00+00	0.00	NULL	NULL	NULL	NULL
2026-11-14 11:00:00+00	60.00	0.5000	0.8000	0.5000	0.8000
2026-11-14 12:00:00+00	20.00	0.7000	0.9000	0.7000	0.9000

# markets() stamps series_ticker, so it can drive candlesticks() directly.
query TI
SELECT c.ticker, count(*) FROM (SELECT series_ticker, ticker FROM kalshi.main.markets('DEMOWX') WHERE ticker = 'DEMOWX-26NOV15-T20') m, LATERAL kalshi.main.candlesticks(m.series_ticker, m.ticker, start_ts => 1794643200, end_ts => 1794657600) c GROUP BY ALL;
----
DEMOWX-26NOV15-T20	4

statement error
SELECT * FROM kalshi.main.candlesticks('DEMOWX', 'DEMOWX-26NOV15-T20', period_interval => 7);
----
<REGEX>:.*
