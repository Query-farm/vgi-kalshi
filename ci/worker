#!/usr/bin/env bash
# The single worker executable ci/run-integration.sh drives: no arguments =
# stdio, `--http --port 0` = HTTP (prints PORT:<n>), and the SDK's own launch
# (unix socket) mode. Runs kalshi_worker.py with the project venv (`make build`).
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
exec "$REPO/.venv/bin/python" "$REPO/kalshi_worker.py" "$@"
